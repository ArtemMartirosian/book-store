# Required by infra/docker-compose.yml for both API and worker.
# Copy this file to .env and replace the intentionally rejected placeholder
# with a unique secret of at least 32 characters. Never commit the real value.
LUMI_ADMIN_API_KEY=replace-with-at-least-32-random-characters
LUMI_ADMIN_USERNAME=admin
LUMI_ADMIN_PASSWORD=replace-with-at-least-16-random-characters

# Docker-local PostgreSQL. These values are intentionally development-only.
# If you change the user, password or database, update LUMI_DATABASE_URL too.
# URL-encode reserved characters in credentials used inside the URL.
LUMI_POSTGRES_DB=lumi_books
LUMI_POSTGRES_USER=lumi
LUMI_POSTGRES_PASSWORD=lumi_local_only
LUMI_POSTGRES_PORT=55432
LUMI_DATABASE_URL=postgresql://lumi:lumi_local_only@postgres:5432/lumi_books?schema=public

# Enable only with documented permission from Books.am. The admin button runs
# a resumable server-side full-catalog pass; 403/429 responses engage the kill switch.
LUMI_CRAWLER_LIVE_ENABLED=false
LUMI_CRAWLER_WRITTEN_PERMISSION=false
LUMI_CRAWLER_DAILY_REQUEST_BUDGET=0
LUMI_CRAWLER_MAX_PRODUCTS_PER_RUN=50
LUMI_CRAWLER_MIN_REQUEST_DELAY_MS=1500
LUMI_CRAWLER_BROWSER_CATALOG_URL=https://www.books.am/ru/catalog/category/view/s/knigi/id/7463/
LUMI_CRAWLER_BROWSER_NAVIGATION_TIMEOUT_MS=60000
LUMI_CRAWLER_BROWSER_MAX_CATALOG_PAGES=50000
LUMI_CRAWLER_BROWSER_MAX_BOOKS=500000
LUMI_REDIS_PORT=56379

# Public origin: blank uses localhost in base Compose and grqaser.am in the
# production override. On the existing preview host explicitly use
# https://grqaser.digitalize.am until the new domain has working DNS and TLS.
NEXT_PUBLIC_SITE_URL=
LUMI_CORS_ORIGINS=
# This flag is used at BOTH image build and runtime. Rebuild web after changing it.
# Never enable it on development, staging or an unready public domain.
SITE_INDEXING_ENABLED=false
# Optional verification tokens supplied by the owner's search-console account.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Optional public shop details. Leave blank until approved by the owner.
# Phone must include the international + prefix; document URLs must use HTTPS.
LUMI_CONTACT_PHONE=
LUMI_CONTACT_EMAIL=
LUMI_CONTACT_TELEGRAM_URL=
LUMI_CONTACT_WHATSAPP_URL=
LUMI_CONTACT_HOURS=
LUMI_TERMS_URL=
LUMI_PRIVACY_URL=
LUMI_RETURNS_URL=
