generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  REQUEST_RECEIVED
  CUSTOMER_CONFIRMED
  PROCUREMENT_PENDING
  SUPPLIER_CONFIRMED
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CUSTOMER_REFUSED
  CANCELLED
}

enum CashStatus {
  CASH_DUE
  CASH_COLLECTED
  CASH_RECONCILED
  CASH_REFUSED
}

enum ProcurementStatus {
  PENDING_OPERATOR
  SUPPLIER_CONFIRMED
  SOURCE_UNAVAILABLE
  CANCELLED
}

/// Durable order envelope. Scalar fields enforce operational invariants and
/// support indexed admin queries; payload is the exact API domain snapshot.
model Order {
  id                  String           @id @db.Uuid
  orderNumber         String           @unique @map("order_number") @db.VarChar(64)
  idempotencyKey      String           @unique @map("idempotency_key") @db.VarChar(128)
  requestHash         String           @map("request_hash") @db.Char(64)
  status              OrderStatus
  cashStatus          CashStatus       @map("cash_status")
  fiscalReceiptNumber String?          @unique @map("fiscal_receipt_number") @db.VarChar(100)
  createdAt           DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @map("updated_at") @db.Timestamptz(3)
  payload             Json             @db.JsonB
  procurementTask     ProcurementTask?

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("orders")
}

/// One operator procurement task per order. Its payload mirrors the supplier
/// evidence snapshot returned by the existing admin API.
model ProcurementTask {
  id          String            @id @db.Uuid
  orderId     String            @unique @map("order_id") @db.Uuid
  orderNumber String            @map("order_number") @db.VarChar(64)
  status      ProcurementStatus
  createdAt   DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @map("updated_at") @db.Timestamptz(3)
  payload     Json              @db.JsonB
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("procurement_tasks")
}

/// Durable Books.am catalog projection. Repeated crawler runs update the same
/// supplier SKU instead of creating duplicate products.
model CatalogBook {
  id              String                   @id @db.Uuid
  supplierSku     String                   @unique @map("supplier_sku") @db.VarChar(128)
  slug            String                   @unique @db.VarChar(180)
  title           String                   @db.VarChar(500)
  author          String                   @db.VarChar(500)
  description     String                   @db.Text
  language        String                   @db.VarChar(2)
  locale          String                   @db.VarChar(2)
  isbn            String?                  @db.VarChar(64)
  publisher       String?                  @db.VarChar(500)
  productCode     String?                  @map("product_code") @db.VarChar(128)
  weight          String?                  @db.VarChar(64)
  barcode         String?                  @db.VarChar(256)
  isNew           Boolean?                 @map("is_new")
  pageCount       Int?                     @map("page_count")
  coverType       String?                  @map("cover_type") @db.VarChar(256)
  dimensions      String?                  @db.VarChar(256)
  publicationYear Int?                     @map("publication_year")
  series          String?                  @db.Text
  imageUrls       String[]                 @default([]) @map("image_urls")
  attributes      Json                     @default("[]") @db.JsonB
  detailSections  Json                     @default("[]") @map("detail_sections") @db.JsonB
  parserVersion   String                   @default("books-html-v1") @map("parser_version") @db.VarChar(64)
  manualEdited    Boolean                  @default(false) @map("manual_edited")
  sourcePriceAmd  Int                      @map("source_price_amd")
  availability    String                   @db.VarChar(32)
  sourceUrl       String                   @unique @map("source_url") @db.VarChar(2048)
  coverImageUrl   String?                  @map("cover_image_url") @db.VarChar(2048)
  observedAt      DateTime                 @map("observed_at") @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations    CatalogBookTranslation[]
  categories      CatalogBookCategory[]

  @@index([observedAt(sort: Desc), id(sort: Desc)])
  @@index([availability, observedAt(sort: Desc), id(sort: Desc)])
  @@map("catalog_books")
}

/// Books.am category tree. Supplier category ids are stable across the three
/// interface locales, while labels and source URLs are localized separately.
model CatalogCategory {
  id                 String                       @id @db.Uuid
  supplierCategoryId String                       @unique @map("supplier_category_id") @db.VarChar(128)
  parentId           String?                      @map("parent_id") @db.Uuid
  position           Int                          @default(0)
  manualEdited       Boolean                      @default(false) @map("manual_edited")
  observedAt         DateTime                     @map("observed_at") @db.Timestamptz(3)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent             CatalogCategory?             @relation("CatalogCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           CatalogCategory[]            @relation("CatalogCategoryTree")
  translations       CatalogCategoryTranslation[]
  books              CatalogBookCategory[]

  @@index([parentId, position, id])
  @@map("catalog_categories")
}

model CatalogCategoryTranslation {
  id           String          @id @db.Uuid
  categoryId   String          @map("category_id") @db.Uuid
  locale       String          @db.VarChar(2)
  name         String          @db.VarChar(500)
  manualEdited Boolean         @default(false) @map("manual_edited")
  sourceUrl    String          @map("source_url") @db.VarChar(2048)
  observedAt   DateTime        @map("observed_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  category     CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([sourceUrl])
  @@index([locale, name])
  @@map("catalog_category_translations")
}

/// A book can be listed in more than one Books.am category.
model CatalogBookCategory {
  bookId     String          @map("book_id") @db.Uuid
  categoryId String          @map("category_id") @db.Uuid
  observedAt DateTime        @map("observed_at") @db.Timestamptz(3)
  book       CatalogBook     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category   CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bookId, categoryId])
  @@index([categoryId, bookId])
  @@map("catalog_book_categories")
}

/// One complete Books.am page snapshot per interface locale. Raw localized
/// attributes and bottom detail sections are retained alongside normalized
/// columns, so newly introduced supplier fields are not silently lost.
model CatalogBookTranslation {
  id              String      @id @db.Uuid
  bookId          String      @map("book_id") @db.Uuid
  locale          String      @db.VarChar(2)
  parserVersion   String      @map("parser_version") @db.VarChar(64)
  manualEdited    Boolean     @default(false) @map("manual_edited")
  title           String      @db.VarChar(500)
  author          String      @db.VarChar(500)
  description     String      @db.Text
  languageLabel   String?     @map("language_label") @db.VarChar(256)
  isbn            String?     @db.VarChar(64)
  publisher       String?     @db.VarChar(500)
  productCode     String      @map("product_code") @db.VarChar(128)
  weight          String?     @db.VarChar(64)
  barcode         String?     @db.VarChar(256)
  isNew           Boolean?    @map("is_new")
  pageCount       Int?        @map("page_count")
  coverType       String?     @map("cover_type") @db.VarChar(256)
  dimensions      String?     @db.VarChar(256)
  publicationYear Int?        @map("publication_year")
  series          String?     @db.Text
  imageUrls       String[]    @default([]) @map("image_urls")
  attributes      Json        @default("[]") @db.JsonB
  detailSections  Json        @default("[]") @map("detail_sections") @db.JsonB
  sourceUrl       String      @unique @map("source_url") @db.VarChar(2048)
  observedAt      DateTime    @map("observed_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  book            CatalogBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, locale])
  @@index([locale, observedAt(sort: Desc), bookId])
  @@map("catalog_book_translations")
}

/// Durable checkpoint for the long-running Books.am browser crawl. The crawler
/// saves the current catalog page so an unexpected process restart only repeats
/// at most one page; catalog upserts keep those repeats idempotent.
model CrawlerCheckpoint {
  id                        String    @id @db.VarChar(64)
  status                    String    @db.VarChar(32)
  startedAt                 DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt               DateTime? @map("completed_at") @db.Timestamptz(3)
  currentUrl                String?   @map("current_url") @db.VarChar(2048)
  resumeCatalogUrl          String?   @map("resume_catalog_url") @db.VarChar(2048)
  catalogPagesVisited       Int       @default(0) @map("catalog_pages_visited")
  discoveredProducts        Int       @default(0) @map("discovered_products")
  productsAttempted         Int       @default(0) @map("products_attempted")
  imported                  Int       @default(0)
  quarantined               Int       @default(0)
  failedProducts            Int       @default(0) @map("failed_products")
  navigationRetries         Int       @default(0) @map("navigation_retries")
  productsSkipped           Int       @default(0) @map("products_skipped")
  catalogSegmentsDiscovered Int       @default(0) @map("catalog_segments_discovered")
  catalogSegmentsCompleted  Int       @default(0) @map("catalog_segments_completed")
  activeCatalogSegment      String?   @map("active_catalog_segment") @db.VarChar(2048)
  catalogSegments           Json      @default("[]") @map("catalog_segments") @db.JsonB
  completedCatalogSegments  Json      @default("[]") @map("completed_catalog_segments") @db.JsonB
  finishReason              String?   @map("finish_reason") @db.Text
  errors                    Json      @default("[]") @db.JsonB
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("crawler_checkpoints")
}
