generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  QUARANTINED
  SOURCE_MISSING
}

enum OfferStatus {
  PRELIMINARY_OBSERVED
  CONFIRMED
  UNAVAILABLE
}

enum OrderStatus {
  REQUEST_RECEIVED
  CUSTOMER_CONFIRMED
  PROCUREMENT_PENDING
  SUPPLIER_CONFIRMED
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CUSTOMER_REFUSED
  CANCELLED
}

enum YerevanDistrict {
  AJAPNYAK
  ARABKIR
  AVAN
  DAVTASHEN
  EREBUNI
  KANAKER_ZEYTUN
  KENTRON
  MALATIA_SEBASTIA
  NOR_NORK
  NORK_MARASH
  NUBARASHEN
  SHENGAVIT
}

enum CashStatus {
  CASH_DUE
  CASH_COLLECTED
  CASH_RECONCILED
  CASH_REFUSED
}

enum ProcurementStatus {
  PENDING_OPERATOR
  SUPPLIER_CONFIRMED
  SOURCE_UNAVAILABLE
  CANCELLED
}

enum CrawlRunStatus {
  CREATED
  RUNNING
  STOPPED
  COMPLETED
  FAILED
}

model Product {
  id           String          @id @default(uuid()) @db.Uuid
  supplierSku  String          @map("supplier_sku")
  title        String
  author       String?
  language     String
  locale       String          @default("hy")
  isbn         String?
  canonicalUrl String          @map("canonical_url")
  status       ProductStatus   @default(DRAFT)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  offers       SupplierOffer[]
  orderItems   OrderItem[]

  @@unique([supplierSku, canonicalUrl])
  @@index([status, language])
  @@map("products")
}

model SupplierOffer {
  id             String      @id @default(uuid()) @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  sourcePriceAmd Int         @map("source_price_amd")
  currency       String      @default("AMD")
  status         OfferStatus @default(PRELIMINARY_OBSERVED)
  salable        Boolean
  observedAt     DateTime    @map("observed_at")
  sourceUrl      String      @map("source_url")
  createdAt      DateTime    @default(now()) @map("created_at")
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, observedAt(sort: Desc)])
  @@map("supplier_offers")
}

model Order {
  id                          String           @id @default(uuid()) @db.Uuid
  orderNumber                 String           @unique @map("order_number")
  idempotencyKey              String           @unique @map("idempotency_key") @db.VarChar(128)
  requestHash                 String           @map("request_hash") @db.Char(64)
  status                      OrderStatus      @default(REQUEST_RECEIVED)
  locale                      String           @default("hy")
  customerName                String           @map("customer_name")
  customerPhone               String           @map("customer_phone")
  customerEmail               String?          @map("customer_email")
  deliveryCity                String           @default("YEREVAN") @map("delivery_city")
  deliveryDistrict            YerevanDistrict  @map("delivery_district")
  deliveryAddress             String           @map("delivery_address")
  paymentMethod               String           @default("CASH_ON_DELIVERY") @map("payment_method")
  currency                    String           @default("AMD")
  itemsSubtotalAmd            Int              @map("items_subtotal_amd")
  deliveryFeeAmd              Int              @map("delivery_fee_amd")
  totalAmd                    Int              @map("total_amd")
  pricingRule                 String           @map("pricing_rule")
  cashDueAmd                  Int              @map("cash_due_amd")
  cashStatus                  CashStatus       @default(CASH_DUE) @map("cash_status")
  collectedAt                 DateTime?        @map("collected_at")
  reconciledAt                DateTime?        @map("reconciled_at")
  fiscalReceiptNumber         String?          @unique @map("fiscal_receipt_number")
  cashReconciliationReference String?          @map("cash_reconciliation_reference")
  cashRefusalReason           String?          @map("cash_refusal_reason")
  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")
  items                       OrderItem[]
  procurementTask             ProcurementTask?

  @@index([status, createdAt(sort: Desc)])
  @@index([cashStatus, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id                   String                   @id @default(uuid()) @db.Uuid
  orderId              String                   @map("order_id") @db.Uuid
  productId            String                   @map("product_id") @db.Uuid
  titleSnapshot        String                   @map("title_snapshot")
  supplierSkuSnapshot  String                   @map("supplier_sku_snapshot")
  quantity             Int
  sourceUnitPriceAmd   Int                      @map("source_unit_price_amd")
  customerUnitPriceAmd Int                      @map("customer_unit_price_amd")
  customerSubtotalAmd  Int                      @map("customer_subtotal_amd")
  order                Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product              Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  procurementSnapshot  ProcurementItemSnapshot?

  @@index([orderId])
  @@map("order_items")
}

model ProcurementTask {
  id                       String                    @id @default(uuid()) @db.Uuid
  orderId                  String                    @unique @map("order_id") @db.Uuid
  status                   ProcurementStatus         @default(PENDING_OPERATOR)
  supplierNameSnapshot     String                    @default("Books.am") @map("supplier_name_snapshot")
  supplierItemsSubtotalAmd Int                       @map("supplier_items_subtotal_amd")
  supplierDeliveryFeeAmd   Int?                      @map("supplier_delivery_fee_amd")
  supplierTotalAmd         Int?                      @map("supplier_total_amd")
  supplierReference        String?                   @map("supplier_reference")
  operatorNote             String?                   @map("operator_note")
  confirmedAt              DateTime?                 @map("confirmed_at")
  resolvedAt               DateTime?                 @map("resolved_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  order                    Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  itemSnapshots            ProcurementItemSnapshot[]

  @@index([status, createdAt(sort: Desc)])
  @@map("procurement_tasks")
}

model ProcurementItemSnapshot {
  id                           String          @id @default(uuid()) @db.Uuid
  procurementTaskId            String          @map("procurement_task_id") @db.Uuid
  orderItemId                  String          @unique @map("order_item_id") @db.Uuid
  productIdSnapshot            String          @map("product_id_snapshot") @db.Uuid
  supplierSkuSnapshot          String          @map("supplier_sku_snapshot")
  titleSnapshot                String          @map("title_snapshot")
  sourceUrlSnapshot            String          @map("source_url_snapshot")
  quantitySnapshot             Int             @map("quantity_snapshot")
  sourceUnitPriceAmdSnapshot   Int             @map("source_unit_price_amd_snapshot")
  customerUnitPriceAmdSnapshot Int             @map("customer_unit_price_amd_snapshot")
  createdAt                    DateTime        @default(now()) @map("created_at")
  procurementTask              ProcurementTask @relation(fields: [procurementTaskId], references: [id], onDelete: Restrict)
  orderItem                    OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([procurementTaskId])
  @@map("procurement_item_snapshots")
}

model CrawlRun {
  id            String         @id @default(uuid()) @db.Uuid
  status        CrawlRunStatus @default(CREATED)
  parserVersion String         @map("parser_version")
  startedAt     DateTime?      @map("started_at")
  finishedAt    DateTime?      @map("finished_at")
  stoppedReason String?        @map("stopped_reason")
  createdAt     DateTime       @default(now()) @map("created_at")
  snapshots     HtmlSnapshot[]

  @@index([status, createdAt(sort: Desc)])
  @@map("crawl_runs")
}

model HtmlSnapshot {
  id           String        @id @default(uuid()) @db.Uuid
  crawlRunId   String        @map("crawl_run_id") @db.Uuid
  sourceUrl    String        @map("source_url")
  finalUrl     String        @map("final_url")
  httpStatus   Int           @map("http_status")
  contentHash  String        @map("content_hash")
  storageRef   String        @map("storage_ref")
  fetchedAt    DateTime      @map("fetched_at")
  crawlRun     CrawlRun      @relation(fields: [crawlRunId], references: [id], onDelete: Restrict)
  parserResult ParserResult?

  @@index([crawlRunId, fetchedAt])
  @@index([sourceUrl])
  @@map("html_snapshots")
}

model ParserResult {
  id               String       @id @default(uuid()) @db.Uuid
  htmlSnapshotId   String       @unique @map("html_snapshot_id") @db.Uuid
  parserVersion    String       @map("parser_version")
  extracted        Json
  warnings         Json
  quarantineReason String?      @map("quarantine_reason")
  parsedAt         DateTime     @default(now()) @map("parsed_at")
  htmlSnapshot     HtmlSnapshot @relation(fields: [htmlSnapshotId], references: [id], onDelete: Restrict)

  @@map("parser_results")
}
