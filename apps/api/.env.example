NODE_ENV=development
# Local development and tests default to IN_MEMORY. Set POSTGRES only when the
# database is reachable and migrations have been applied.
PERSISTENCE_ADAPTER=IN_MEMORY
API_HOST=0.0.0.0
API_PORT=4000
# Keep 0 when API is reached directly; otherwise set the exact trusted proxy hop count.
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:3000
ADMIN_API_KEY=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-16-random-characters

# Customer pricing, all values are integer AMD.
PRICE_MARKUP_PER_ITEM_AMD=500
DELIVERY_FEE_AMD=1000
ESTIMATED_LAST_MILE_COST_AMD=1000
ESTIMATED_INBOUND_DELIVERY_COST_AMD=0
ESTIMATED_PACKAGING_COST_AMD=0
PRICING_RISK_BUFFER_AMD=0
MIN_PROJECTED_MARGIN_AMD=0

# Safety-first crawler defaults. LIVE must remain false until written permission.
CRAWLER_LIVE_ENABLED=false
CRAWLER_WRITTEN_PERMISSION=false
CRAWLER_DAILY_REQUEST_BUDGET=0
CRAWLER_USER_AGENT=LUMIBooksCatalogBot/0.1 (+mailto:crawler-ops@lumi.am)
CRAWLER_REQUEST_TIMEOUT_MS=10000
CRAWLER_MAX_RESPONSE_BYTES=2097152
CRAWLER_MAX_SITEMAP_BYTES=33554432
CRAWLER_MAX_REDIRECTS=1
CRAWLER_MIN_REQUEST_DELAY_MS=1000
# XML discovery entries are not HTTP requests. This cap covers large locale indexes.
CRAWLER_MAX_SITEMAP_URLS=200000
# This is the HTTP-sized batch leased from the process-local product queue per run.
CRAWLER_MAX_PRODUCTS_PER_RUN=50
CRAWLER_BROWSER_EXECUTABLE=/usr/bin/chromium-browser
CRAWLER_BROWSER_CATALOG_URL=https://www.books.am/ru/catalog/category/view/s/knigi/id/7463/
CRAWLER_BROWSER_NAVIGATION_TIMEOUT_MS=60000
CRAWLER_BROWSER_MAX_CATALOG_PAGES=50000
CRAWLER_BROWSER_MAX_BOOKS=500000
CRAWLER_MAX_CHILD_SITEMAPS_PER_RUN=20
CRAWLER_MAX_KNOWN_PRODUCT_URLS=250000
CRAWLER_PRODUCT_REFRESH_INTERVAL_MS=86400000

# Required when PERSISTENCE_ADAPTER=POSTGRES. This host URL is for non-Docker development.
DATABASE_URL=postgresql://lumi:lumi_local_only@localhost:55432/lumi_books?schema=public
