NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_INTERNAL_URL=http://localhost:4000

# Keep local development out of search. Rebuild after changing this flag:
# Next.js response headers are recorded during next build.
SITE_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Optional public shop details. Leave blank until approved by the owner.
# Phone must include the international + prefix; document URLs must use HTTPS.
LUMI_CONTACT_PHONE=
LUMI_CONTACT_EMAIL=
LUMI_CONTACT_TELEGRAM_URL=
LUMI_CONTACT_WHATSAPP_URL=
LUMI_CONTACT_HOURS=
LUMI_TERMS_URL=
LUMI_PRIVACY_URL=
LUMI_RETURNS_URL=
